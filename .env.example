# Core storage: the Postgres database eyetable owns and writes everything into.
EYETABLE_DATABASE_URL=postgresql+psycopg://eyetable:eyetable@localhost:5432/eyetable

# Schemas inside the core database (optional; these are the defaults).
EYETABLE_META_SCHEMA=eyetable
EYETABLE_DATA_SCHEMA=eyetable_raw

# Read-only role for the page's query window (scripts/setup-postgres.ps1 creates it).
# EYETABLE_QUERY_DATABASE_URL=postgresql+psycopg://eyetable_reader:...@localhost:5432/eyetable
# EYETABLE_QUERY_TIMEOUT_S=30

# Web API (`eyetable serve`). The token is what the source management page asks
# for; make it long and random:  python -c "import secrets; print(secrets.token_urlsafe(32))"
EYETABLE_API_TOKEN=
# Sites allowed to call the API from a browser (comma-separated).
EYETABLE_CORS_ORIGINS=https://tootallted.github.io
# EYETABLE_MAX_UPLOAD_MB=50

# Google access for scheduled runs of private Google Sheets (see README).
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=...      (Google Cloud Console > Google Auth Platform > Clients)
# EYETABLE_SECRET_KEY=...       python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# Source secrets. Source configs reference these as ${NAME} so credentials
# never have to be written into the core database. Examples:
# CRM_DB_PASSWORD=...
# EYETABLE_MYAPI_API_KEY=...
